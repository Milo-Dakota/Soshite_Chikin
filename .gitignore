# Ren'Py local saves and regenerable caches.
/game/saves/
/game/cache/

# This Demo has been released. Keep .rpyc/.rpymc alongside source scripts
# to preserve published script metadata for save compatibility.
# Do not ignore game/libs, game/tl, fonts, licenses, or runtime media.

# Ren'Py editor/recovery copies, not historical snapshots in archive/.
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Ren'Py diagnostic output in the project root.
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt
/lint.txt
/profile.txt

# Regenerable dialogue exports. Keep project.json and formal script sources.
/dialogue.tab
/dialogue.txt
/strings.json

# Local build dependencies, scratch space and distribution output.
# Historical snapshots in archive/ are tracked separately.
/.build/
/build/
/dist/
/*-dists/
/tmp/
/temp/

# Python tooling caches and local virtual environments.
__pycache__/
*.py[cod]
/.venv/
/venv/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/.coverage
/.coverage.*
/htmlcov/

# Local credentials. Example/template configuration may be committed.
.env
.env.*
!.env.example
!.env.sample
!.env.template
/.secrets/

# OS metadata and editor-local recovery files.
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
/.idea/workspace.xml
/.idea/shelf/

# Production sources and historical snapshots remain versioned.
# Keep scripts/, docs/, assets/, audio/, archive/ and game/ media.
# Do not add blanket image/audio/font/archive-extension ignore rules.
